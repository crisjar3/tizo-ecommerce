{
  "name": "tizo-ecommerce",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "18.20.x",
    "pnpm": "10.34.x"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration development",
    "start:mock": "ng serve --configuration mock",
    "build": "ng build --configuration production",
    "build:mock": "ng build --configuration mock",
    "build:demo": "pnpm build:mock",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "test": "ng test",
    "test:ci": "node scripts/test-ci.mjs",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "api:sync": "node scripts/sync-official-openapi.mjs && pnpm api:generate",
    "api:generate": "openapi-typescript docs/contracts/tizo.openapi.yaml -o src/app/core/api/generated/tizo-api.types.ts",
    "api:contract:lint": "redocly lint docs/contracts/tizo.openapi.yaml --skip-rule no-ambiguous-paths",
    "api:contract:check": "pnpm api:contract:lint && pnpm api:generate && git diff --exit-code -- docs/contracts/tizo.openapi.yaml src/app/core/api/generated/tizo-api.types.ts",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" \"*.{json,ts}\" \".github/**/*.yml\"",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@angular/animations": "16.2.12",
    "@angular/cdk": "16.2.14",
    "@angular/common": "16.2.12",
    "@angular/compiler": "16.2.12",
    "@angular/core": "16.2.12",
    "@angular/forms": "16.2.12",
    "@angular/platform-browser": "16.2.12",
    "@angular/platform-browser-dynamic": "16.2.12",
    "@angular/router": "16.2.12",
    "@fontsource/manrope": "5.3.0",
    "@ngrx/component-store": "16.3.0",
    "lucide-angular": "1.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.6.3",
    "zone.js": "0.13.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "16.2.16",
    "@angular-eslint/builder": "16.3.1",
    "@angular-eslint/eslint-plugin": "16.3.1",
    "@angular-eslint/eslint-plugin-template": "16.3.1",
    "@angular-eslint/schematics": "16.3.1",
    "@angular-eslint/template-parser": "16.3.1",
    "@angular/cli": "16.2.16",
    "@angular/compiler-cli": "16.2.12",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.52.0",
    "@redocly/cli": "1.34.5",
    "@types/jasmine": "4.3.6",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "@typescript-eslint/types": "5.62.0",
    "eslint": "8.57.1",
    "jasmine-core": "4.6.1",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "msw": "2.8.7",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "typescript": "5.1.6"
  },
  "msw": {
    "workerDirectory": [
      "src"
    ]
  }
}
